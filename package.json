{
  "name": "urine-strip-reader",
  "productName": "Urine strip reader",
  "version": "1.3.1",
  "description": "Windows app that reads urine test strip pads with an Arduino Uno + TCS34725 colour sensor, recognises the parameter from its colour, and makes a PDF report.",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test \"tests/*.test.cjs\"",
    "embed-firmware": "node tools/embed-firmware.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.urine-strip-reader",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["index.html", "style.css", "js/**/*", "desktop/**/*", "package.json"],
    "electronLanguages": ["en-US"],
    "compression": "maximum",
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Urine-strip-reader-Setup-${version}.${ext}"
    }
  }
}
